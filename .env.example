# Copy this file to .env and fill in your own values.
# .env itself is gitignored — never commit real credentials.
#
# Get this from your Neon (https://neon.tech) or Supabase (https://supabase.com)
# project dashboard — it's the "connection string" for the Postgres database.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
